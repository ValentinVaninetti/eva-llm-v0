#version 450

// C = A*B con tiling en registros.
//
// POR QUÉ NO ES UN HILO POR ELEMENTO (que es lo que había): con tiles de 16 en
// memoria compartida, cada hilo hacía 16 FMAs leyendo 32 valores de LDS. Uno
// coma cinco lecturas por multiplicación: el shader no estaba limitado por
// cómputo sino por memoria compartida, y ninguna cantidad de padding arregla
// eso porque el problema no son los conflictos de banco, es el volumen.
//
// Acá cada hilo calcula un bloque de 4x4 de C. Lee 4 valores de A y 4 de B --8
// lecturas-- y hace 16 FMAs. Pasa de 2 lecturas por FMA a 0.5: cuatro veces
// menos tráfico de LDS para el mismo resultado.
//
// El grupo es de 16x16 hilos y cubre un tile de 64x64 de C, avanzando de a 16
// en K.

#define TILE 64u   // filas y columnas de C por grupo
#define BK   16u   // profundidad en K por paso
#define TT    4u   // lado del bloque que calcula cada hilo

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer BufA { float a[]; };
layout(set = 0, binding = 1, std430) readonly buffer BufB { float b[]; };
layout(set = 0, binding = 2, std430) buffer BufC { float c[]; };

layout(push_constant) uniform PC {
    uint M;
    uint K;
    uint N;
} pc;

// A queda TRANSPUESTA en LDS ([k][m]) para que el lazo interno lea a lo largo
// de m. El +1 no es decorativo: sin él, la fila k arranca en el banco
// (k*64)%32 = 0 y los cuatro hilos que escriben la misma columna caen todos en
// el banco 0. Con 65, la fila k arranca en el banco k y se reparten.
shared float As[BK][TILE + 1u];

// B se guarda como vec4: cada hilo del lazo interno se lleva sus cuatro
// columnas en una sola lectura ancha, en vez de cuatro lecturas con paso 4
// que colisionan de a dos.
shared vec4 Bs[BK][TILE / 4u];

void main() {
    uint tx = gl_LocalInvocationID.x;        // 0..15 -> columnas 4*tx .. 4*tx+3
    uint ty = gl_LocalInvocationID.y;        // 0..15 -> filas    4*ty .. 4*ty+3
    uint tid = ty * 16u + tx;                // 0..255

    uint row0 = gl_WorkGroupID.y * TILE;
    uint col0 = gl_WorkGroupID.x * TILE;

    // Una fila de acumuladores por fila del bloque. En registros: 16 floats.
    vec4 acc[TT];
    for (uint i = 0u; i < TT; i++) {
        acc[i] = vec4(0.0);
    }

    // Reparto de la carga, fijo para todos los pasos de K.
    // A: 64 filas x 16 k = 1024 valores, 4 por hilo, contiguos en k para que la
    // lectura global salga coalescida.
    uint ar = tid / 4u;                      // 0..63, fila dentro del tile
    uint ak = (tid % 4u) * 4u;               // 0,4,8,12: bloque de k
    // B: 16 k x 64 n = 1024 valores, un vec4 contiguo por hilo.
    uint bk = tid / 16u;                     // 0..15, k dentro del tile
    uint bn = tid % 16u;                     // 0..15, grupo de 4 columnas

    uint steps = (pc.K + BK - 1u) / BK;
    for (uint t = 0u; t < steps; t++) {
        uint k0 = t * BK;

        uint am = row0 + ar;
        bool arow = am < pc.M;
        for (uint i = 0u; i < 4u; i++) {
            uint kk = k0 + ak + i;
            As[ak + i][ar] = (arow && kk < pc.K) ? a[am * pc.K + kk] : 0.0;
        }

        uint kb = k0 + bk;
        uint n0 = col0 + bn * 4u;
        vec4 v = vec4(0.0);
        if (kb < pc.K) {
            uint base = kb * pc.N + n0;
            // Cuatro columnas contiguas. El borde derecho de la matriz es el
            // único caso donde no entran las cuatro.
            v.x = (n0 + 0u < pc.N) ? b[base + 0u] : 0.0;
            v.y = (n0 + 1u < pc.N) ? b[base + 1u] : 0.0;
            v.z = (n0 + 2u < pc.N) ? b[base + 2u] : 0.0;
            v.w = (n0 + 3u < pc.N) ? b[base + 3u] : 0.0;
        }
        Bs[bk][bn] = v;

        barrier();

        for (uint kk = 0u; kk < BK; kk++) {
            // Una lectura ancha de B, cuatro de A (que son broadcast: todos los
            // hilos con el mismo ty piden el mismo valor).
            vec4 bv = Bs[kk][tx];
            uint m0 = ty * TT;
            acc[0] += As[kk][m0 + 0u] * bv;
            acc[1] += As[kk][m0 + 1u] * bv;
            acc[2] += As[kk][m0 + 2u] * bv;
            acc[3] += As[kk][m0 + 3u] * bv;
        }

        barrier();
    }

    for (uint i = 0u; i < TT; i++) {
        uint m = row0 + ty * TT + i;
        if (m >= pc.M) {
            continue;
        }
        uint n = col0 + tx * TT;
        uint base = m * pc.N + n;
        if (n + 3u < pc.N) {
            c[base + 0u] = acc[i].x;
            c[base + 1u] = acc[i].y;
            c[base + 2u] = acc[i].z;
            c[base + 3u] = acc[i].w;
        } else {
            // Sólo el borde derecho paga el camino de a uno.
            if (n + 0u < pc.N) c[base + 0u] = acc[i].x;
            if (n + 1u < pc.N) c[base + 1u] = acc[i].y;
            if (n + 2u < pc.N) c[base + 2u] = acc[i].z;
            if (n + 3u < pc.N) c[base + 3u] = acc[i].w;
        }
    }
}
